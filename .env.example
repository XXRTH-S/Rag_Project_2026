# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า (อย่า commit .env)
# ค่า default ด้านล่างคือ Tier LOCAL สำหรับ RTX 3050 6GB (ดู PLAN.md ข้อ 3)

# ---------- Model tier: local | mid | prod ----------
MODEL_TIER=local

# ---------- LLM ----------
# local : http://ollama:11434/v1   (Ollama ในคอนเทนเนอร์)
# prod  : http://llm:8000/v1       (vLLM)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:4b
LLM_HF_REPO=Qwen/Qwen3.5-4B
LLM_MAX_MODEL_LEN=8192
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180
LLM_ENABLE_THINKING=false
# คำลงท้ายสุภาพของบอท — "ครับ" หรือ "ค่ะ" · เว้นว่างถ้าไม่ต้องการ
BOT_POLITE_PARTICLE=ครับ
# Ollama ไม่รู้จัก chat_template_kwargs ต้องใช้ฟิลด์นี้ถึงจะปิด thinking ได้จริง
# ตั้งเป็นค่าว่างถ้าเจอ provider ที่ปฏิเสธค่า "none"
LLM_REASONING_EFFORT=none

# ---------- LLM สำรอง (failover) ----------
# ลำดับการเรียก: ตัวหลัก (LLM_*) -> ตัวสำรอง (LLM_FALLBACK_*) -> ยกข้อความจากเอกสาร
#
# ตอนนี้ตั้งโมเดลในเครื่องเป็นตัวหลัก ถ้าอยากใช้ API เป็นหลักให้สลับเป็น:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=<ใส่ key>
#   LLM_MODEL=qwen/qwen3.5-4b
#   LLM_FALLBACK_BASE_URL=http://ollama:11434/v1
#   LLM_FALLBACK_MODEL=qwen3.5:4b
# เว้น LLM_FALLBACK_BASE_URL ว่างเพื่อปิดตัวสำรอง
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# หยุดเรียกตัวหลักชั่วคราวหลังล้มติดกันกี่ครั้ง กันไม่ให้ทุกคำถามรอ timeout
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=120

# ---------- OCR ----------
TYPHOON_OCR_BASE_URL=http://ollama:11434/v1
TYPHOON_OCR_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr
TYPHOON_OCR_HF_REPO=typhoon-ai/typhoon-ocr1.5-2b
TYPHOON_OCR_TASK_TYPE=default
TYPHOON_OCR_CONCURRENCY=1
TYPHOON_OCR_PAGE_TIMEOUT=120

# ---------- Embedding ----------
EMBEDDING_BASE_URL=http://embeddings:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_API_KEY=

# ---------- GPU / model runtime ----------
HF_TOKEN=
HF_HOME=/root/.cache/huggingface
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=1h
OLLAMA_NUM_PARALLEL=1

# ---------- Datastores ----------
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag
DATABASE_URL=postgresql+asyncpg://rag:changeme@postgres:5432/rag
REDIS_URL=redis://redis:6379/0

# ---------- Quota ----------
QUOTA_TIMEZONE=Asia/Bangkok
USER_DAILY_DOCUMENT_LIMIT=5
USER_DAILY_PAGE_LIMIT=500
USER_MAX_PAGES_PER_DOCUMENT=200
ADMIN_UNLIMITED=true
CHARS_PER_PAGE_ESTIMATE=3000

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5
# วัดแล้วดีกว่า vector อย่างเดียวชัดเจน: hit@1 88% -> 100%, MRR 0.882 -> 1.000
# วัดซ้ำได้ด้วย .dc.ps1 exec api python scripts/eval.py
RETRIEVAL_HYBRID=true
RETRIEVAL_KEYWORD_FLOOR=0.40
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------- App / Auth ----------
APP_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000
PUBLIC_API_URL=http://localhost:8000

# วัดจริงบน RTX 3050: 5.2 วิ/หน้า (หน้าเรนเดอร์สะอาด) ตั้ง 10 เผื่อสแกนจริงที่ช้ากว่า
OCR_SECONDS_PER_PAGE=10

# นาทีที่งานค้างคิวโดยไม่มี worker มารับ ก่อนถือว่าตายและปล่อยให้สั่งใหม่ได้
INGESTION_STALE_AFTER_MINUTES=30
