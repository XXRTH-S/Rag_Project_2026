# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า (อย่า commit .env)
# ค่า default ด้านล่างคือ Tier LOCAL สำหรับ RTX 3050 6GB (ดู PLAN.md ข้อ 3)

# ---------- Model tier: local | mid | prod ----------
MODEL_TIER=local

# ---------- LLM ----------
# local : http://ollama:11434/v1   (Ollama ในคอนเทนเนอร์)
# prod  : http://llm:8000/v1       (vLLM)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:4b
LLM_HF_REPO=Qwen/Qwen3.5-4B
LLM_MAX_MODEL_LEN=8192
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180
LLM_ENABLE_THINKING=false
# คำลงท้ายสุภาพของบอท — "ครับ" หรือ "ค่ะ" · เว้นว่างถ้าไม่ต้องการ
BOT_POLITE_PARTICLE=ครับ
# Ollama ไม่รู้จัก chat_template_kwargs ต้องใช้ฟิลด์นี้ถึงจะปิด thinking ได้จริง
# ตั้งเป็นค่าว่างถ้าเจอ provider ที่ปฏิเสธค่า "none"
LLM_REASONING_EFFORT=none

# ---------- LLM สำรอง (failover) ----------
# ลำดับการเรียก: ตัวหลัก (LLM_*) -> ตัวสำรอง (LLM_FALLBACK_*) -> ยกข้อความจากเอกสาร
#
# ตอนนี้ตั้งโมเดลในเครื่องเป็นตัวหลัก ถ้าอยากใช้ API เป็นหลักให้สลับเป็น:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=<ใส่ key>
#   LLM_MODEL=qwen/qwen3.5-4b
#   LLM_FALLBACK_BASE_URL=http://ollama:11434/v1
#   LLM_FALLBACK_MODEL=qwen3.5:4b
# เว้น LLM_FALLBACK_BASE_URL ว่างเพื่อปิดตัวสำรอง
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# หยุดเรียกตัวหลักชั่วคราวหลังล้มติดกันกี่ครั้ง กันไม่ให้ทุกคำถามรอ timeout
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=120

# ---------- OCR ----------
TYPHOON_OCR_BASE_URL=http://ollama:11434/v1
TYPHOON_OCR_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr
TYPHOON_OCR_HF_REPO=typhoon-ai/typhoon-ocr1.5-2b
TYPHOON_OCR_TASK_TYPE=default
TYPHOON_OCR_CONCURRENCY=1
TYPHOON_OCR_PAGE_TIMEOUT=120

# ---------- Embedding ----------
EMBEDDING_BASE_URL=http://embeddings:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_API_KEY=

# ---------- GPU / model runtime ----------
HF_TOKEN=
HF_HOME=/root/.cache/huggingface
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=1h
OLLAMA_NUM_PARALLEL=1

# ---------- Datastores ----------
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag
DATABASE_URL=postgresql+asyncpg://rag:changeme@postgres:5432/rag
REDIS_URL=redis://redis:6379/0

# ---------- Quota ----------
QUOTA_TIMEZONE=Asia/Bangkok
USER_DAILY_DOCUMENT_LIMIT=5
USER_DAILY_PAGE_LIMIT=500
USER_MAX_PAGES_PER_DOCUMENT=200
ADMIN_UNLIMITED=true
CHARS_PER_PAGE_ESTIMATE=3000

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5
# วัดแล้วดีกว่า vector อย่างเดียวชัดเจน: hit@1 88% -> 100%, MRR 0.882 -> 1.000
# วัดซ้ำได้ด้วย .dc.ps1 exec api python scripts/eval.py
RETRIEVAL_HYBRID=true
RETRIEVAL_KEYWORD_FLOOR=0.40
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------- App / Auth ----------
APP_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000
PUBLIC_API_URL=http://localhost:8000

# วัดจริงบน RTX 3050: 5.2 วิ/หน้า (หน้าเรนเดอร์สะอาด) ตั้ง 10 เผื่อสแกนจริงที่ช้ากว่า
OCR_SECONDS_PER_PAGE=10

# นาทีที่งานค้างคิวโดยไม่มี worker มารับ ก่อนถือว่าตายและปล่อยให้สั่งใหม่ได้
INGESTION_STALE_AFTER_MINUTES=30

# /docs /redoc /openapi.json — แจกผังของทั้ง API รวมถึง endpoint ฝั่ง admin
# ให้คนที่ยังไม่ได้ล็อกอิน จึงปิดเป็นค่าเริ่มต้น
# ตอน dev ไม่ต้องแก้ที่นี่ — docker-compose.override.yml เปิดให้อยู่แล้ว
API_DOCS_ENABLED=false

# เส้นทางนำเข้าเอกสารต้องมี Celery worker, poppler/libmagic, GPU และดิสก์ถาวร
# ตั้ง false เมื่อ deploy ไปที่ที่ไม่มีของพวกนี้ (เช่น Vercel) แล้ว endpoint
# อัปโหลด/bulk/reprocess จะตอบ 503 พร้อมบอกทาง แทนที่จะล้มเงียบ ๆ
INGESTION_ENABLED=true

# กันการเดารหัสผ่าน สองชั้น
#   ชั้นแรก ต่อ IP — เข้มงวด จับคนที่ยิงรัวจากที่เดียว
#   ชั้นสอง ต่ออีเมล — หลวมกว่า เป็นตาข่ายรับคนที่หมุน IP หนีชั้นแรก (ตั้ง 0 เพื่อปิด)
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_ATTEMPTS_PER_EMAIL=30
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900
RATE_LIMIT_PLAYGROUND_PER_MINUTE=10

# จำนวน proxy ที่เราคุมเองที่คั่นอยู่หน้า API — ใช้หา IP จริงจาก X-Forwarded-For
#   0  API เปิดตรงออกอินเทอร์เน็ต ห้ามเชื่อ header เลย
#   1  หลัง Caddy ของเราเอง (ค่าปกติของ docker-compose.yml)
#   2  หลัง ngrok แล้วต่อเข้า Caddy (docker-compose.https.yml ตั้งให้แล้ว)
# ตั้งสูงเกินจริงเท่ากับเชื่อค่าที่ผู้เรียกแต่งมาเอง ซึ่งเปิดช่องเลี่ยง rate limit
TRUSTED_PROXY_HOPS=1

# true เมื่อเปิด HTTPS จริง — ไม่งั้น browser ส่ง cookie ผ่าน http ธรรมดาได้
COOKIE_SECURE=false

# Demo accounts: generate unique passwords locally; never commit real credentials.
DEMO_USER_1_EMAIL=demo01@example.com
DEMO_USER_1_PASSWORD=
DEMO_USER_2_EMAIL=demo02@example.com
DEMO_USER_2_PASSWORD=
DEMO_USER_3_EMAIL=demo03@example.com
DEMO_USER_3_PASSWORD=
DEMO_USER_4_EMAIL=demo04@example.com
DEMO_USER_4_PASSWORD=
DEMO_USER_5_EMAIL=demo05@example.com
DEMO_USER_5_PASSWORD=
VERCEL_PROJECT_ID=prj_4cqCBJjVFg9I7EAW0qr2otkUy1HJ

# HTTPS tunnel for the closed demo (keep token private)
NGROK_AUTHTOKEN=
