{
	# ใช้ในวงแลน/เครื่องเดียว ไม่ต้องขอ cert จริง
	# ถ้าเปิดออกอินเทอร์เน็ต: ลบบรรทัดนี้ เปลี่ยน :80 เป็นชื่อโดเมน แล้ว Caddy จะขอ TLS ให้เอง
	auto_https off

	servers {
		# เชื่อ forwarding headers จาก proxy ในเครือข่าย private
		# API ต้องตั้ง TRUSTED_PROXY_HOPS ให้ตรงกับเส้นทางจริงเพื่อป้องกันการปลอม IP
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# ส่ง health check ไปยัง API แทนหน้าเว็บ
	handle /health* {
		reverse_proxy api:8000
	}

	# SSE ของ /api/chat ต้องไม่ถูก buffer ไม่งั้น token จะมาเป็นก้อนเดียวตอนจบ
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /widget.js {
		reverse_proxy web:3000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
