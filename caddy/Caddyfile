{
	# ใช้ในวงแลน/เครื่องเดียว ไม่ต้องขอ cert จริง
	# ถ้าเปิดออกอินเทอร์เน็ต: ลบบรรทัดนี้ เปลี่ยน :80 เป็นชื่อโดเมน แล้ว Caddy จะขอ TLS ให้เอง
	auto_https off

	servers {
		# ค่าเริ่มต้นของ Caddy คือ "เขียนทับ X-Forwarded-For ด้วย IP ของ peer เสมอ"
		# ซึ่งปลอดภัยดีเมื่อ Caddy เป็นด่านแรก แต่พังเมื่อมี tunnel คั่นอยู่ข้างหน้า
		# เพราะ IP ของ peer กลายเป็นคอนเทนเนอร์ ngrok เหมือนกันหมดทุกคำขอ
		# แล้ว rate limit ก็ยุบเป็นถังเดียวทั้งโลก (เจอจริง 21 ก.ย. 2026)
		#
		# บอกให้เชื่อ peer ที่อยู่ในวง private เพื่อให้ Caddy *ต่อท้าย* แทนการเขียนทับ
		# ผู้เรียกจากอินเทอร์เน็ตไม่เคยเป็น peer โดยตรงอยู่แล้ว (มี tunnel หรือ
		# docker port mapping คั่นเสมอ) การเชื่อวง private จึงไม่ได้เปิดช่องให้ใคร
		#
		# ตัวที่กันการปลอมจริง ๆ คือฝั่ง API ที่นับ entry จากขวาเข้ามาตาม
		# TRUSTED_PROXY_HOPS ไม่ใช่การหยิบตัวซ้ายสุด — ดู app/core/ratelimit.py
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# health อยู่นอก /api ตามสเปกของ orchestrator ทั่วไป (k8s, docker healthcheck)
	# ถ้าไม่ route ไว้ที่นี่ monitor ภายนอกที่ยิงพอร์ต 80 จะไปโดนหน้าเว็บแล้วได้ 404
	handle /health* {
		reverse_proxy api:8000
	}

	# SSE ของ /api/chat ต้องไม่ถูก buffer ไม่งั้น token จะมาเป็นก้อนเดียวตอนจบ
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /widget.js {
		reverse_proxy web:3000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
